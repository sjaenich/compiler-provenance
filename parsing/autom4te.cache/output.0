    fi
  fi
  if test "$PKGTEST" = "yes" && test "$PKGCONFIG" != "no"; then
    addlib=`CURL_EXPORT_PCDIR($LIBMETALINK_PCDIR)       $PKGCONFIG --libs-only-l libmetalink`
    addld=`CURL_EXPORT_PCDIR($LIBMETALINK_PCDIR)       $PKGCONFIG --libs-only-L libmetalink`
