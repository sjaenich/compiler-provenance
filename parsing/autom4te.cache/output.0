then :
  
      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes ($version)" >&5
printf "%s\n" "yes ($version)" >&6; }
      want_metalink="yes"
    
else $as_nop
  
      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no ($version)" >&5
printf "%s\n" "no ($version)" >&6; }
      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: libmetalink library defective or too old" >&5
printf "%s\n" "$as_me: libmetalink library defective or too old" >&6;}
