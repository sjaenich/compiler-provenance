  help:   --disable-largefile     omit support for large files)
  definition: "")
  logic:  
 name: http
  help:   --enable-http           Enable HTTP support
  --disable-http          Disable HTTP support)
  definition: "CURL_DISABLE_HTTP=1;CURL_DISABLE_RTSP=1;")
  logic:  case "$enableval" in
  no)
       AC_MSG_RESULT(no)
       AC_DEFINE(CURL_DISABLE_HTTP, 1, [to disable HTTP])
       disable_http="yes"
       AC_MSG_WARN([disable HTTP disables FTP over proxy and RTSP])
       AC_SUBST(CURL_DISABLE_HTTP, [1])
       AC_DEFINE(CURL_DISABLE_RTSP, 1, [to disable RTSP])
       AC_SUBST(CURL_DISABLE_RTSP, [1])
       ;;
  *)   AC_MSG_RESULT(yes)
       ;;
  esac  
